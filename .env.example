# ==============================================================================
# KONFIGURASI DATABASE REAL: POSTGRESQL LOKAL (pgAdmin / PostgreSQL 17)
# SI611029 - Sistem Informasi KRS & Perwalian SIAKAD UNJANI
# ==============================================================================

# Host database lokal
DB_HOST=localhost

# Port PostgreSQL: Di komputer Anda PostgreSQL 17 aktif di port 5433 (atau 5432)
DB_PORT=5432

# Nama database yang dibuat di pgAdmin/DBeaver
DB_NAME=krs_unjani

# User dan Password PostgreSQL Anda
DB_USER=postgres
DB_PASSWORD=postgres

# Port server backend Express
PORT=5005
NODE_ENV=development
